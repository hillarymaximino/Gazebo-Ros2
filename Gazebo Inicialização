import os
from ament_index_python.packages import get_package_share_directory
from launch import LaunchDescription
from launch.actions import ExecuteProcess
from launch_ros.actions import Node

def generate_launch_description():
    pkg_share = get_package_share_directory('meu_robo_wsl')
    urdf_file = os.path.join(pkg_share, 'urdf/robo.urdf')

    with open(urdf_file, 'r') as infp:
        robot_desc = infp.read()

    return LaunchDescription([
        # Liga o simulador Gazebo
        ExecuteProcess(cmd=['gz', 'sim', '-r', 'empty.sdf'], output='screen'),
        
        # Publica o robô para o sistema
        Node(package='robot_state_publisher', executable='robot_state_publisher', 
             parameters=[{'robot_description': robot_desc}]),
             
        # Cria o robô visualmente no mundo
        Node(package='ros_gz_sim', executable='create',
             arguments=['-name', 'meu_robo', '-topic', 'robot_description', '-z', '0.5']),
             
        # CRIA A PONTE (Bridge) entre o teclado e o motor
        Node(package='ros_gz_bridge', executable='parameter_bridge',
             arguments=['/cmd_vel@geometry_msgs/msg/Twist@gz.msgs.Twist'])
    ])
